# 数据库与缓存（与 docker-compose.yml 一致，Redis 容器映射在 6380）
DATABASE_URL=postgresql://admin:password@localhost:5432/knowledge_agent
REDIS_URL=redis://localhost:6380/0

# Java 后端回调
JAVA_BASE_URL=http://localhost:8080
INTERNAL_TOKEN=knowledge-agent-internal-token-2026-change-me

# DeepSeek（OpenAI 兼容接口）—— 必填：复制本文件为 .env 后在此填入你的 Key
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Embedding 模型（bge-small-zh 输出 512 维，与数据库 vector(512) 一致）
# 在线下载：EMBEDDING_MODEL=BAAI/bge-small-zh（国内可先设 HF_ENDPOINT=https://hf-mirror.com）
# 本地模型（modelscope 已下载到 ai-service/models/）：EMBEDDING_MODEL=models/bge-small-zh
EMBEDDING_MODEL=BAAI/bge-small-zh

# 重排序（交叉编码器）：先召回 top20 再重排取 top5，显著提升检索准确率
# 下载：modelscope download --model BAAI/bge-reranker-base --local_dir models/bge-reranker-base
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-base
RETRIEVAL_K=20

# 查询改写：多轮追问时先用 LLM 把问题改写为独立完整问题再检索
REWRITE_ENABLED=true

# 混合检索：向量 + BM25（jieba 中文分词）RRF 融合，关键词/专有名词召回更好
HYBRID_ENABLED=true
RRF_K=60

# 敏感词过滤：逗号分隔；命中则拒绝提问、回答中自动打码
SENSITIVE_WORDS=

# 分块参数
CHUNK_SIZE=500
CHUNK_OVERLAP=50
