# 数据库与缓存（与 docker-compose.yml 一致，Redis 容器映射在 6380）
DATABASE_URL=postgresql://admin:password@localhost:5432/knowledge_agent
REDIS_URL=redis://localhost:6380/0

# Java 后端回调
JAVA_BASE_URL=http://localhost:8080
INTERNAL_TOKEN=knowledge-agent-internal-token-2026-change-me

# DeepSeek（OpenAI 兼容接口）—— 必填：复制本文件为 .env 后在此填入你的 Key
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Embedding 模型（bge-small-zh 输出 512 维，与数据库 vector(512) 一致）
# 在线下载：EMBEDDING_MODEL=BAAI/bge-small-zh（国内可先设 HF_ENDPOINT=https://hf-mirror.com）
# 本地模型（modelscope 已下载到 ai-service/models/）：EMBEDDING_MODEL=models/bge-small-zh
EMBEDDING_MODEL=BAAI/bge-small-zh

# 分块参数
CHUNK_SIZE=500
CHUNK_OVERLAP=50
